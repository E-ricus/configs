{
  // Load .envrc / flake devshell env per worktree ("direct" = the default,
  // spelled out for clarity). Applies to LSPs, tasks and the terminal.
  "project_panel": {
    "hide_gitignore": true,
    "hide_hidden": true
  },
  "load_direnv": "direct",
  "lsp": {
    "json-language-server": {
      "binary": {
        "allow_binary_download": false
      },
      "enable_lsp_tasks": true
    },
    // rust-analyzer from PATH (rustup), same as nvim/helix/emacs. Switch cargo
    // targets with `gram-rust-target` (space r t h/w) — it writes a
    // project-local .gram/settings.jsonc that overrides this block.
    "rust-analyzer": {
      "binary": {
        "path": "rust-analyzer"
      },
      "initialization_options": {
        "checkOnSave": false,
        "check": {
          "command": "clippy",
          "workspace": false
        },
        "cargo": {
          "buildScripts": {
            "enable": true
          }
        },
        "procMacro": {
          "enable": true
        },
        "semanticHighlighting": {
          "strings": {
            "enable": false
          }
        }
      }
    }
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled"
}
