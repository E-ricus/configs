#!/usr/bin/env bash
# gram-rust-target — switch rust-analyzer's cargo target for a Gram project.
#
# cargo.target is passed via initialization_options ("" = host). Writes <root>/.gram/settings.jsonc; Gram watches
# local settings and restarts rust-analyzer with the new config. If it ever
# doesn't pick it up, run "editor: restart language server" from the palette.
#
# Usage: gram-rust-target {host|windows} [project-root]
set -euo pipefail

MARKER="generated by gram-rust-target"

preset="${1:-}"
root="${2:-$PWD}"

case "$preset" in
  host)
    target=""
    ;;
  windows)
    target="x86_64-pc-windows-gnu"
    ;;
  *)
    echo "usage: gram-rust-target {host|windows} [project-root]" >&2
    exit 1
    ;;
esac

settings_dir="$root/.gram"
settings_file="$settings_dir/settings.jsonc"

# Refuse to clobber a hand-written local settings file.
if [[ -f "$settings_file" ]] && ! grep -q "$MARKER" "$settings_file"; then
  echo "error: $settings_file exists and was not $MARKER; not overwriting" >&2
  exit 1
fi

# cargo block: only include "target" when one is set.
if [[ -n "$target" ]]; then
  cargo_block=$(printf '{\n          "buildScripts": { "enable": true },\n          "target": "%s"\n        }' "$target")
else
  cargo_block='{
          "buildScripts": { "enable": true }
        }'
fi

mkdir -p "$settings_dir"
cat > "$settings_file" <<EOF
// ${MARKER} — preset: ${preset}. Do not edit by hand; rerun the script.
{
  "lsp": {
    "rust-analyzer": {
      "binary": {
        "path": "rust-analyzer"
      },
      "initialization_options": {
        "checkOnSave": false,
        "check": {
          "command": "clippy",
          "workspace": false
        },
        "cargo": ${cargo_block},
        "procMacro": {
          "enable": true
        },
        "semanticHighlighting": {
          "strings": {
            "enable": false
          }
        }
      }
    }
  }
}
EOF

echo "rust-analyzer target: ${preset}${target:+ (${target})} -> ${settings_file}"
